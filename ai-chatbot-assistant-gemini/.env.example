# Copy this file to a new file named ".env" and paste your real key below.
# NEVER commit the real .env file to GitHub (it is listed in .gitignore).
# Never paste your key into chats, screenshots or source code either.

GEMINI_API_KEY=enter-your-gemini-api-key-here

# --- Optional settings (uncomment to change the defaults) ---
# GEMINI_MODEL=gemini-3.5-flash-lite
# MAX_TOKENS=2048
# MAX_HISTORY_MESSAGES=20
